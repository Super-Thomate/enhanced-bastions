<section class="tab bastion-tab bastion-description {{tabs.description.cssClass}}"
         data-tab="description" data-group="primary">
  <h2>{{localize "ENHANCED_BASTIONS.Bastion.Description"}}</h2>
  {{#if editable}}
  <prose-mirror name="system.description" value="{{source.system.description}}" toggled
                data-document-uuid="{{document.uuid}}">{{{enrichedDescription}}}</prose-mirror>
  {{else}}
  <div class="bastion-description-view">{{{enrichedDescription}}}</div>
  {{/if}}
</section>
